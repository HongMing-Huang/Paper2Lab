{
  "name": "paper2lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Paper2Lab — Reactive Paper on an infinite research desk. Hero demo: Wang–Zahl 3D Kakeya (arXiv:2502.17655).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:render": "pnpm build && node scripts/render-webgl-test.mjs",
    "precompute": "c++ -std=c++17 -O3 -pthread scripts/precompute_kakeya.cpp -o scripts/precompute_kakeya && ./scripts/precompute_kakeya xxl | node --import tsx scripts/build_kakeya_bundle.ts",
    "engine": "node --import tsx scripts/engine_server.ts"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.142.0",
    "@mujoco/mujoco": "3.12.0",
    "@observablehq/plot": "^0.6.17",
    "@observablehq/runtime": "^6.0.1",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.8.0",
    "@tldraw/tldraw": "^5.5.0",
    "@xyflow/react": "^12.12.0",
    "comlink": "^4.4.2",
    "jsxgraph": "^1.13.3",
    "mathlive": "^0.110.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
