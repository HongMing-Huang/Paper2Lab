# Smoke variant of the ModelScope image (Dockerfile) — used ONLY to verify
# the runtime layers on hosts where the in-container `vite build` cannot
# finish (npm egress throttled). The RUNTIME layers (python deps, node,
# engine node_modules, prebundled engine, server sources, wasm, port 7860,
# /mnt/workspace) are IDENTICAL to Dockerfile; only dist/ comes pre-built
# from the host (the exact bundle the product-path scripts verified).
#
# Build: docker build -f Dockerfile.smoke -t paper2lab:0.1-ms .
# Then:  ./scripts/ms-container-smoke.sh paper2lab:0.1-ms

# ---- engine deps + PREBUNDLED engine (plain node, zero transpile) ----------
# full pnpm install (dev deps on: esbuild is tsx's pinned dep) so the bin
# shim works, bundle the engine, then prune to production node_modules
FROM node:22-slim AS engine-deps
WORKDIR /app
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
COPY package.json pnpm-lock.yaml ./
COPY src/ src/
COPY scripts/engine_server.ts scripts/engine_persist.ts scripts/engine_once.ts /app/bundle-entry/
RUN corepack enable && corepack prepare pnpm@10.30.2 --activate \
  && (pnpm install --frozen-lockfile || pnpm install --frozen-lockfile --registry=https://registry.npmmirror.com) \
  && ESB=./node_modules/.pnpm/esbuild@0.28.2/node_modules/esbuild/bin/esbuild \
  && $ESB /app/bundle-entry/engine_server.ts \
       --bundle --packages=external --platform=node --format=esm \
       --outfile=/tmp/engine_server.bundle.mjs --log-level=warning \
  && $ESB /app/bundle-entry/engine_once.ts \
       --bundle --packages=external --platform=node --format=esm \
       --outfile=/tmp/engine_once.mjs --log-level=warning \
  && mkdir -p scripts \
  && cp /tmp/engine_server.bundle.mjs scripts/engine_server.bundle.mjs \
  && cp /tmp/engine_once.mjs scripts/engine_once.mjs \
  && pnpm install --frozen-lockfile --prod \
  && pnpm store prune

# ---- python + node single-origin runtime -----------------------------------
FROM python:3.12-slim AS api
WORKDIR /app
ENV PIP_NO_CACHE_DIR=1
COPY server/requirements.txt server/requirements.txt
RUN pip install --no-cache-dir --timeout 120 --retries 5 -r server/requirements.txt \
    --extra-index-url https://download.pytorch.org/whl/cpu || \
    pip install --no-cache-dir --timeout 120 --retries 5 \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    -r server/requirements.txt

COPY --from=node:22-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=engine-deps /app/node_modules/ node_modules/
COPY --from=engine-deps /app/scripts/engine_server.bundle.mjs scripts/engine_server.bundle.mjs
COPY scripts/engine_server.ts scripts/engine_persist.ts scripts/

COPY server/ server/
COPY src/ src/
COPY tsconfig.json ./
COPY package.json ./

COPY dist/ dist/
COPY public/ public/
RUN mkdir -p dist/assets/mujoco public/assets/mujoco \
  && cp node_modules/@mujoco/mujoco/mujoco.wasm dist/assets/mujoco/mujoco.wasm \
  && cp node_modules/@mujoco/mujoco/mujoco.wasm public/assets/mujoco/mujoco.wasm

ENV PAPER2LAB_DATA_DIR=/mnt/workspace
ENV PAPER2LAB_ENGINE_BOOT_TIMEOUT=300 \
    PAPER2LAB_ENGINE_TIMEOUT=600
EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:7860/api/health')" || exit 1
CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "7860"]
